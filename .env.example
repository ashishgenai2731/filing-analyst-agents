# Copy to .env and fill in. .env is git-ignored.
PINECONE_API_KEY=your-pinecone-key
PINECONE_INDEX_NAME=doc-intelligence-edgar
# EDGAR returns 403 without a contact email in the User-Agent
SEC_USER_AGENT=Your Name you@example.com
# Optional: LangSmith tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-key
LANGCHAIN_PROJECT=filing-analyst-agents
# Optional overrides (defaults in config/settings.py)
# AGENT_MODEL=qwen2.5:7b-instruct
# LLM_MODEL=mistral
# OLLAMA_BASE_URL=http://localhost:11434
# REDIS_HOST=localhost
